{
  "name": "gpt-oss-search",
  "version": "1.0.0",
  "description": "Real-time semantic search using GPT-OSS models with P2P networking",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "default": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts", 
      "import": "./dist/server.js",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "test": "node --test src/**/*.test.js",
    "build": "tsc -p .",
    "dev": "tsc -p . --watch",
    "clean": "rm -rf dist"
  },
  "keywords": ["gpt-oss", "semantic-search", "ai", "p2p", "real-time"],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "search-core": "workspace:*",
    "ai-search": "workspace:*",
    "p2p-delta": "workspace:*",
    "openai-harmony": "^0.4.0",
    "gpt-oss": "^1.0.0",
    "ws": "^8.18.0",
    "uuid": "^10.0.0",
    "tiktoken": "^1.0.22"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.12",
    "@types/uuid": "^10.0.0"
  }
}